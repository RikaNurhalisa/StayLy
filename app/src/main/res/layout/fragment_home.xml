<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/my_primary"
    android:padding="16dp"
    tools:context=".HomeFragment">

    <!-- Header Tetap di Atas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="StayLy"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Rekomendasi Kos untuk Anda"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- ScrollView untuk Daftar Kosan (akan mengisi sisa ruang) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Contoh Item Kos 1 (Tampilan Manual) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp" >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kos1" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kost Anggrek"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 1.500.000 / bulan"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.8 Bintang"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Malang, Jawa Timur"
                            android:textColor="#000000"/>

                        <Button
                            android:id="@+id/btnFavKos1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tambah ke Favorit"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/my_primary"
                            android:textColor="#FFFFFF"/>

                        <Button
                            android:id="@+id/btnChatKos1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chat Pemilik"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="@android:color/holo_green_dark"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Contoh Item Kos 2 (Tampilan Manual) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp" >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kos2" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kost Melati Residence"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 2.000.000 / bulan"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.9 Bintang"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jakarta Selatan"
                            android:textColor="#000000"/>

                        <Button
                            android:id="@+id/btnFavKos2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tambah ke Favorit"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/my_primary"
                            android:textColor="#FFFFFF"/>

                        <Button
                            android:id="@+id/btnChatKos2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chat Pemilik"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="@android:color/holo_green_dark"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Contoh Item Kos 3 (Tampilan Manual) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp" >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kos3" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kos Mawar Merah"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 900.000 / bulan"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.5 Bintang"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bandung, Jawa Barat"
                            android:textColor="#000000"/>

                        <Button
                            android:id="@+id/btnFavKos3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tambah ke Favorit"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/my_primary"
                            android:textColor="#FFFFFF"/>

                        <Button
                            android:id="@+id/btnChatKos3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chat Pemilik"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="@android:color/holo_green_dark"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Contoh Item Kos 4 (Tampilan Manual) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp" >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <ImageView
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/kos4" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kos Cendrawasih"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 1.800.000 / bulan"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.7 Bintang"
                            android:textColor="#000000"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Yogyakarta, DIY"
                            android:textColor="#000000"/>

                        <Button
                            android:id="@+id/btnFavKos4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tambah ke Favorit"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/my_primary"
                            android:textColor="#FFFFFF"/>

                        <Button
                            android:id="@+id/btnChatKos4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chat Pemilik"
                            android:layout_marginTop="4dp"
                            android:backgroundTint="@android:color/holo_green_dark"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>